# The known-good 8.3.19 image supplies PostgreSQL, fonts and Sentinel/PCSC.
# 8.3.27 is installed alongside it; both server versions run concurrently.
FROM vasilyvz/vvz-1csrv-postgres:backup-8.3.19.1351-20260713

ARG ONEC_8327_VERSION=8.3.27.2214
ENV ONEC_8319_VERSION=8.3.19.1351 \
    ONEC_8327_VERSION=${ONEC_8327_VERSION}

COPY install/8.3.27/deb64_8_3_27_2214.zip /tmp/onec-8.3.27.zip

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends unzip; \
    mkdir -p /tmp/onec-8.3.27; \
    unzip -q /tmp/onec-8.3.27.zip -d /tmp/onec-8.3.27; \
    dpkg -i \
      /tmp/onec-8.3.27/1c-enterprise-8.3.27.2214-common-nls_8.3.27-2214_amd64.deb \
      /tmp/onec-8.3.27/1c-enterprise-8.3.27.2214-common_8.3.27-2214_amd64.deb \
      /tmp/onec-8.3.27/1c-enterprise-8.3.27.2214-server-nls_8.3.27-2214_amd64.deb \
      /tmp/onec-8.3.27/1c-enterprise-8.3.27.2214-server_8.3.27-2214_amd64.deb \
      /tmp/onec-8.3.27/1c-enterprise-8.3.27.2214-ws-nls_8.3.27-2214_amd64.deb \
      /tmp/onec-8.3.27/1c-enterprise-8.3.27.2214-ws_8.3.27-2214_amd64.deb \
      || apt-get install -y -f; \
    test -x "/opt/1cv8/x86_64/8.3.19.1351/ragent"; \
    test -x "/opt/1cv8/x86_64/${ONEC_8327_VERSION}/ragent"; \
    ln -sfn "/opt/1cv8/x86_64/8.3.19.1351/srv1cv83" /etc/init.d/srv1cv83; \
    rm -rf /var/lib/apt/lists/* /tmp/onec-8.3.27 /tmp/onec-8.3.27.zip

# Containers do not run systemd. PID 1 supervises both exact versioned agents.
COPY docker/start-stack-dual.sh /usr/local/bin/start-stack-dual.sh
COPY docker/srv1cv83-8319.conf /etc/vvz-1c/srv1cv83-8319.conf
COPY docker/srv1cv83-8327.conf /etc/vvz-1c/srv1cv83-8327.conf
RUN chmod 0755 /usr/local/bin/start-stack-dual.sh \
    && chmod 0644 /etc/vvz-1c/srv1cv83-8319.conf /etc/vvz-1c/srv1cv83-8327.conf

CMD ["/usr/local/bin/start-stack-dual.sh"]
