[Unit]
Description=Dual 1C 8.3.19.1351 + 8.3.27.2214 and Postgres Pro (Docker Compose)
After=docker.service docker.socket network-online.target
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/vvz-1csrv-postgres-8327/stack-start
ExecStop=/usr/libexec/vvz-1csrv-postgres-8327/stack-stop
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
