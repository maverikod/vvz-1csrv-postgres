#!/usr/bin/env bash
# Обёртка над docker compose для каталога /usr/share/vvz-1csrv-postgres-8327
# Подкоманда: status — состояние PostgreSQL и 1С (ragent).
set -euo pipefail
SHARE=/usr/share/vvz-1csrv-postgres-8327
for f in /etc/default/pgsql1c-stack-8327 /etc/default/vvz-1csrv-postgres-8327; do
  if [[ -f "$f" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$f"
    set +a
  fi
done
export PGSQL1C_VAR="${PGSQL1C_VAR:-/var/pgsql1c}"
export PGSQL1C_LOG="${PGSQL1C_LOG:-/var/log/pgsql1c}"
export PGSQL1C_ETC="${PGSQL1C_ETC:-/etc/pgsql1c}"
export PGSQL1C_BACKUP="${PGSQL1C_BACKUP:-${PGSQL1C_VAR}/backups}"
export PGSQL1C_DOCKER_SUBNET="${PGSQL1C_DOCKER_SUBNET:-172.31.0.0/16}"
export PGSQL1C_CONTAINER_IP="${PGSQL1C_CONTAINER_IP:-172.31.0.2}"
export PGSQL1C_PGHBA_MODE="${PGSQL1C_PGHBA_MODE:-managed}"
export PGSQL1C_PGHBA_AUTH_METHOD="${PGSQL1C_PGHBA_AUTH_METHOD:-md5}"
export VVZ_IMAGE="${VVZ_IMAGE:-docker.io/vasilyvz/vvz-1csrv-postgres:8.3.27.2214-dual-8.3.19.1351-r1@sha256:386ecbad5e5c709f589668aed5aa657c5f570f36a675567ce5b8aab75af67c23}"
export ONEC_HOSTNAME="${ONEC_HOSTNAME:-devel1c}"

if [[ "${1:-}" == "status" ]]; then
  exec /usr/libexec/vvz-1csrv-postgres-8327/stack-status
fi

if [[ "${1:-}" == "backup" ]]; then
  exec /usr/libexec/vvz-1csrv-postgres-8327/pgsql1c-backup-8327
fi

if [[ "${1:-}" == "verify" ]]; then
  exec /usr/libexec/vvz-1csrv-postgres-8327/pgsql1c-verify-storage
fi

cd "$SHARE"
exec docker compose -f docker-compose.yml "$@"
