#!/usr/bin/env bash
# Статус контейнера, PostgreSQL и ragent (1С). Те же переменные, что у vvz-1csrv-postgres-8327.
set -euo pipefail
for f in /etc/default/pgsql1c-stack-8327 /etc/default/vvz-1csrv-postgres-8327; do
  if [[ -f "$f" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$f"
    set +a
  fi
done
export PGSQL1C_VAR="${PGSQL1C_VAR:-/var/pgsql1c}"
export PGSQL1C_LOG="${PGSQL1C_LOG:-/var/log/pgsql1c}"
export PGSQL1C_ETC="${PGSQL1C_ETC:-/etc/pgsql1c}"
export PGSQL1C_DOCKER_SUBNET="${PGSQL1C_DOCKER_SUBNET:-172.31.0.0/16}"
export PGSQL1C_CONTAINER_IP="${PGSQL1C_CONTAINER_IP:-172.31.0.2}"
export PGSQL1C_PGHBA_MODE="${PGSQL1C_PGHBA_MODE:-managed}"
export PGSQL1C_PGHBA_AUTH_METHOD="${PGSQL1C_PGHBA_AUTH_METHOD:-md5}"
export VVZ_IMAGE="${VVZ_IMAGE:-docker.io/vasilyvz/vvz-1csrv-postgres:8.3.27.2214-dual-8.3.19.1351-r1@sha256:386ecbad5e5c709f589668aed5aa657c5f570f36a675567ce5b8aab75af67c23}"
export ONEC_HOSTNAME="${ONEC_HOSTNAME:-devel1c}"

DIR="${COMPOSE_PROJECT_DIR:-/usr/share/vvz-1csrv-postgres-8327}"
cd "$DIR"

echo "=== Docker Compose (сервис app) ==="
if ! docker compose ps -a 2>/dev/null; then
  echo "docker compose недоступен или нет доступа к Docker."
  exit 1
fi

cid="$(docker compose ps -q app 2>/dev/null || true)"
if [[ -z "${cid}" ]]; then
  echo ""
  echo "PostgreSQL: контейнер не запущен"
  echo "1С (ragent): контейнер не запущен"
  exit 1
fi

echo ""
echo "=== PostgreSQL ==="
if docker compose exec -T app /opt/pgpro/std-16/bin/pg_isready -h 127.0.0.1 -p 5432 2>/dev/null; then
  echo "Состояние: принимает подключения (порт 5432 внутри контейнера)."
else
  echo "Состояние: не отвечает или кластер ещё не готов."
fi

echo ""
echo "=== 1С:Enterprise dual runtime ==="
for spec in '8.3.19.1351 1540 1541 1560:1591' '8.3.27.2214 1740 1741 1760:1791'; do
  read -r version port regport range <<<"$spec"
  if docker compose exec -T --user usr1cv8 app sh -lc \
    "for p in /proc/[0-9]*; do [ \"\$(readlink \"\$p/exe\" 2>/dev/null)\" = /opt/1cv8/x86_64/$version/ragent ] || continue; tr '\\0' ' ' <\"\$p/cmdline\" | grep -q -- '-port $port.*-regport $regport.*-range $range.*-debug' && exit 0; done; exit 1"; then
    echo "OK: $version ragent $port/$regport/$range debug"
  else
    echo "FAIL: $version ragent not healthy"
  fi
done
