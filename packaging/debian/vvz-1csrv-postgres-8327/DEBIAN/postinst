#!/bin/bash
set -e
VAR=/var/pgsql1c

LOCALE="ru_UA.utf8"
if [ -f /usr/share/debconf/confmodule ]; then
  # shellcheck source=/dev/null
  . /usr/share/debconf/confmodule
  if [ -f /usr/share/vvz-1csrv-postgres-8327/debconf/locale.template ]; then
    debconf-loadtemplate vvz-1csrv-postgres-8327 /usr/share/vvz-1csrv-postgres-8327/debconf/locale.template 2>/dev/null || true
  fi
  db_version 2.0 || true
  if [ "$1" = "configure" ] && [ -z "$2" ]; then
    db_input medium vvz-1csrv-postgres-8327/default-locale || true
  fi
  db_go || true
  db_get vvz-1csrv-postgres-8327/default-locale || true
  if [ -n "${RET:-}" ]; then
    LOCALE="$RET"
  fi
fi

case "$LOCALE" in
  ru_UA.utf8|ru_RU.utf8|uk_UA.utf8) ;;
  *) LOCALE=ru_UA.utf8 ;;
esac

# Образ проверяется и при необходимости скачивается в preinst (до распаковки пакета).

# --- Каталоги, пользователи, конфиги, initdb, сервисы ---
LIB=/usr/libexec/vvz-1csrv-postgres-8327
# shellcheck source=/dev/null
. "${LIB}/pgsql1c-host-users.sh"

pgsql1c_ensure_host_users
if [ ! -f /var/lib/vvz-1csrv-postgres-8327/transition-ready ]; then
  echo "vvz-1csrv-postgres-8327: transition snapshot marker is missing." >&2
  echo "Run: sudo ./packaging/install-dual-1c.sh" >&2
  exit 1
fi
SNAPSHOT_DIR="$(cat /var/lib/vvz-1csrv-postgres-8327/transition-ready)"
if [ ! -f "$SNAPSHOT_DIR/old-storage.tar" ] || [ ! -f "$SNAPSHOT_DIR/SHA256SUMS" ] \
  || ! (cd "$SNAPSHOT_DIR" && sha256sum -c SHA256SUMS >/dev/null); then
  echo "vvz-1csrv-postgres-8327: transition snapshot verification failed." >&2
  exit 1
fi

if docker inspect -f '{{.State.Running}}' vvz-1csrv-postgres-app-1 2>/dev/null | grep -qx true; then
  echo "vvz-1csrv-postgres-8327: preserved old container is running; refusing shared-data startup." >&2
  exit 1
fi

install -d -m 0755 /etc/pgsql1c
for version in 8319 8327; do
  dst="/etc/pgsql1c/srv1cv83-${version}"
  src="/usr/share/vvz-1csrv-postgres-8327/srv1cv83-${version}.default"
  if [ ! -f "$dst" ]; then
    install -m 0644 "$src" "$dst"
  fi
done

pgsql1c_chown_host_data

TEMPLATE=/usr/share/vvz-1csrv-postgres-8327/pgsql1c-stack-8327.default
CFG=/etc/default/pgsql1c-stack-8327

if [ ! -f "$CFG" ] && [ -f "$TEMPLATE" ]; then
  cp -a "$TEMPLATE" "$CFG"
fi
if [ -f "$CFG" ]; then
  if ! bash -c 'set -a; . "$1"; set +a' _ "$CFG" 2>/dev/null; then
    echo "vvz-1csrv-postgres-8327: повреждён $CFG — восстановление из $TEMPLATE" >&2
    if [ ! -f "$TEMPLATE" ]; then
      echo "vvz-1csrv-postgres-8327: нет файла $TEMPLATE" >&2
      exit 1
    fi
    cp -a "$TEMPLATE" "$CFG"
  fi
fi
# This package intentionally takes over the old storage/network contract.
# Do not retain the isolated 1.0.18 defaults across the upgrade.
cp -a "$TEMPLATE" "$CFG"

IMAGE_CFG=/etc/default/vvz-1csrv-postgres-8327
PINNED_IMAGE='docker.io/vasilyvz/vvz-1csrv-postgres:8.3.27.2214-dual-8.3.19.1351-r1@sha256:386ecbad5e5c709f589668aed5aa657c5f570f36a675567ce5b8aab75af67c23'
if [ -f "$IMAGE_CFG" ]; then
  tmp=$(mktemp)
  awk -v image="$PINNED_IMAGE" '
    /^VVZ_IMAGE=/ { print "VVZ_IMAGE=" image; image_found=1; next }
    /^ONEC_HOSTNAME=/ { print "ONEC_HOSTNAME=devel1c"; host_found=1; next }
    { print }
    END {
      if (!image_found) print "VVZ_IMAGE=" image
      if (!host_found) print "ONEC_HOSTNAME=devel1c"
    }
  ' "$IMAGE_CFG" >"$tmp"
  chmod --reference="$IMAGE_CFG" "$tmp" 2>/dev/null || true
  mv "$tmp" "$IMAGE_CFG"
fi

if [ -f "$CFG" ]; then
  if grep -q '^INITDB_LOCALE=' "$CFG" 2>/dev/null; then
    tmp=$(mktemp)
    if awk -v loc="$LOCALE" '/^INITDB_LOCALE=/ { print "INITDB_LOCALE=" loc; next } { print }' "$CFG" > "$tmp"; then
      chmod --reference="$CFG" "$tmp" 2>/dev/null || true
      mv "$tmp" "$CFG"
    else
      rm -f "$tmp"
      exit 1
    fi
  else
    echo "INITDB_LOCALE=${LOCALE}" >> "$CFG"
  fi
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload 2>/dev/null || true
fi

if [ ! -f "${VAR}/postgres/PG_VERSION" ]; then
  echo "vvz-1csrv-postgres-8327: old PostgreSQL PGDATA is missing; refusing initialization." >&2
  exit 1
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl enable pgsql1c-stack-8327.service 2>/dev/null || true
  if ! systemctl start pgsql1c-stack-8327.service; then
    echo "vvz-1csrv-postgres-8327: не удалось запустить pgsql1c-stack-8327.service." >&2
    echo "vvz-1csrv-postgres-8327: см. sudo journalctl -u pgsql1c-stack-8327.service -b --no-pager" >&2
    exit 1
  fi
  ready=0
  for _ in $(seq 1 90); do
    if /usr/libexec/vvz-1csrv-postgres-8327/pgsql1c-verify-storage >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 1
  done
  if [ "$ready" -ne 1 ]; then
    /usr/libexec/vvz-1csrv-postgres-8327/pgsql1c-verify-storage || true
    echo "vvz-1csrv-postgres-8327: dual runtime readiness failed." >&2
    exit 1
  fi
  rm -f /var/lib/vvz-1csrv-postgres-8327/transition-ready
fi
exit 0
