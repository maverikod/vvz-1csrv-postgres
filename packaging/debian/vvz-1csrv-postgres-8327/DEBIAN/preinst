#!/bin/sh
set -e
# До распаковки пакета: Docker и образ (локально или pull). Без успеха — установка не идёт.
case "$1" in
  install|upgrade) ;;
  *) exit 0 ;;
esac

if ! command -v docker >/dev/null 2>&1; then
  echo "vvz-1csrv-postgres-8327: команда docker не найдена. Установите docker.io или docker-ce (зависимости пакета) и повторите." >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "vvz-1csrv-postgres-8327: демон Docker не отвечает. Запустите: sudo systemctl enable --now docker" >&2
  exit 1
fi

VVZ_IMAGE=docker.io/vasilyvz/vvz-1csrv-postgres:8.3.27.2214-dual-8.3.19.1351-r1@sha256:386ecbad5e5c709f589668aed5aa657c5f570f36a675567ce5b8aab75af67c23

echo "vvz-1csrv-postgres-8327: unconditional pull of pinned dual image." >&2
docker pull "$VVZ_IMAGE" || {
  echo "vvz-1csrv-postgres-8327: pinned image pull failed." >&2
  exit 1
}
docker image inspect "$VVZ_IMAGE" >/dev/null
docker run --rm --entrypoint /bin/sh "$VVZ_IMAGE" -ec '
  test -x /opt/1cv8/x86_64/8.3.19.1351/ragent
  test -x /opt/1cv8/x86_64/8.3.19.1351/rmngr
  test -x /opt/1cv8/x86_64/8.3.19.1351/rphost
  test -x /opt/1cv8/x86_64/8.3.27.2214/ragent
  test -x /opt/1cv8/x86_64/8.3.27.2214/rmngr
  test -x /opt/1cv8/x86_64/8.3.27.2214/rphost
  test -x /usr/local/bin/start-stack-dual.sh
'

exit 0
